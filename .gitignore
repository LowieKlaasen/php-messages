###> Symfony core ###
# Local environment overrides (may contain secrets). Commit .env, never these.
/.env.local
/.env.local.php
/.env.*.local
# Private decryption key for production secrets vault
/config/secrets/prod/prod.decrypt.private.php
# Generated by assets:install
/public/bundles/
# Cache, logs, sessions
/var/
# Composer dependencies (restored via `composer install`)
/vendor/
